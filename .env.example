# Copie para .env. Nunca versionar valores reais.
# "local" ou "test" habilitam as rotas /dev/* de simulação; qualquer outro valor as desliga.
APP_ENV=local
LOG_LEVEL=INFO

STORE_NAME=Açaí Ki-Delícia PL
STORE_TIMEZONE=America/Sao_Paulo
STORE_WEBSITE_URL=https://acaikideliciapl.com.br

# Banco local (criado por: uv run python -m app.cli migrate)
DATABASE_URL=sqlite+aiosqlite:///./data/acai.db

# Painel. Em produção (HTTPS) mantenha SESSION_COOKIE_SECURE=true.
SESSION_COOKIE_SECURE=false
SESSION_TTL_HOURS=12

# Fila de envio
OUTBOX_WORKER_ENABLED=true
OUTBOX_MAX_ATTEMPTS=5

# Retenção (dias). Decisão do proprietário: 14 dias para dados de clientes.
RETENTION_DAYS=14
AUDIT_RETENTION_DAYS=365

# Painel só pelo próprio PC (recomendado com túnel). Vazio = qualquer host.
ADMIN_ALLOWED_HOSTS=

# WhatsApp Cloud API (Etapa 3). Guia: docs/configuracao-meta.md e docs/teste-com-tunel.md
# "fake" não usa rede. "cloud" exige APP_ENV=staging/production e todas as variáveis abaixo.
WHATSAPP_GATEWAY=fake
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
META_GRAPH_API_VERSION=v25.0
# Fora de produção, só estes números recebem mensagens (dígitos, separados por vírgula).
WHATSAPP_ALLOWED_RECIPIENTS=
PAUSE_ON_OWNER_ECHO=true

# Etapa 4 (ainda não lido pelo código)
# LLM_API_KEY=
# LLM_MODEL=
